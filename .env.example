# PostgreSQL connection string
DATABASE_URL="postgresql://nightstop:nightstop@localhost:5432/nightstop"

# Random secret for session encryption: `npx auth secret` or `openssl rand -base64 33`
AUTH_SECRET=""

# Public URL of the app (needed in production behind a proxy), e.g. https://nightstop.firma.ch
# AUTH_URL="https://nightstop.firma.ch"
# AUTH_TRUST_HOST=true

# Microsoft Entra ID (Azure AD) app registration, see README
AUTH_MICROSOFT_ENTRA_ID_ID=""          # Application (client) ID
AUTH_MICROSOFT_ENTRA_ID_SECRET=""      # Client secret value
AUTH_MICROSOFT_ENTRA_ID_ISSUER="https://login.microsoftonline.com/<TENANT-ID>/v2.0"  # required: only this tenant may sign in

# Recommended: only allow these email domains (comma separated)
ALLOWED_EMAIL_DOMAINS=""

# Optional: also allow guest (B2B) accounts invited into the tenant
ALLOW_GUEST_ACCOUNTS="false"

# Optional: start admins (comma separated). They can make more admins in the app (/admin)
# and can never be removed there.
ADMIN_EMAILS=""

# ---------- Optional external service ----------

# Weekly digest email. Leave SMTP_HOST empty to disable mail.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"        # "true" for port 465
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM=""               # e.g. "Touchdown <touchdown@firma.ch>"
# Secret for POST /api/cron/digest (min. 16 characters): openssl rand -hex 24
CRON_SECRET=""

# Local development only: show a login form without Azure (ignored in production builds)
AUTH_DEV_LOGIN="false"
